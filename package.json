{
  "name": "strapi-plugin-deskcrew",
  "version": "1.0.0",
  "description": "Turn Strapi entries (contact forms, feedback, support requests) into DeskCrew support tickets, and keep your DeskCrew widget key in one place.",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-v5",
    "strapi-v4",
    "contact form",
    "form to ticket",
    "support",
    "helpdesk",
    "help desk",
    "customer support",
    "live chat",
    "ai support",
    "ticketing",
    "support tickets",
    "knowledge base",
    "deskcrew"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webmilmind1/strapi-plugin-deskcrew.git"
  },
  "homepage": "https://deskcrew.io/integrations/strapi",
  "bugs": {
    "url": "https://github.com/webmilmind1/strapi-plugin-deskcrew/issues",
    "email": "hello@deskcrew.io"
  },
  "author": "DeskCrew <hello@deskcrew.io> (https://deskcrew.io)",
  "license": "MIT",
  "main": "strapi-server.js",
  "exports": {
    "./strapi-server": "./strapi-server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "strapi-server.js",
    "server/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "strapi": {
    "kind": "plugin",
    "name": "deskcrew",
    "displayName": "DeskCrew",
    "description": "Entries from a collection become DeskCrew support tickets."
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "peerDependencies": {
    "@strapi/strapi": ">=4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
